# ============================================================================
# AI Football Agency Strategy Desk — Environment Configuration (.env)
# ============================================================================

# 1. GCP Vertex AI (ADC 인증 방식)
# 터미널에서 `gcloud auth application-default login` 실행 시 별도 API 키 없이 자동 인증됩니다.
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# 2. LLM 모델 이원화 설정
# - 고성능 추론/협상/문서작성 (Node 2 Hermes 분석, Node 4 모의 협상, Node 5 투트랙 문서)
PRIMARY_LLM_MODEL=gemini-3.8-flash
# - 경량 고속 라우팅/요약 (Node 1 Supervisor 분기, Node 3 규정 RAG 요약, 뉴스 요약)
LIGHT_LLM_MODEL=gemini-3.5-flash

# 3. 임베딩 모델 이원화 설정
# - 고성능 멀티모달/장문 임베딩 (공식 규정집, GBE 점수표, FIFA FFAR 벡터 테이블용)
PRIMARY_EMBEDDING_MODEL=gemini-embedding-2
# - 경량 텍스트 임베딩 (선수 스카우팅 리포트 & 구단 전술 스타일 유사도 매칭용: gemini-embedding-001 또는 text-embedding-004)
LIGHT_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768

# 4. 실시간 축구 데이터 API 설정
# - Football-Data.org (기본 5대 리그 스쿼드/순위/감독 실시간 동기화 - 일일 무제한)
FOOTBALL_DATA_API_KEY=your_football_data_api_key_here
# - API-Football (무료 100회/일 정밀 타격 - 공식 부상/이적/글로벌 1,100개 리그 실시간 갱신용)
API_FOOTBALL_KEY=your_api_football_key_here
API_FOOTBALL_DAILY_LIMIT=100

# 5. 실시간 검색 설정 (기본: Vertex AI Google Search Grounding 사용)
USE_GOOGLE_SEARCH_GROUNDING=true

# 6. [우선순위 2위] Tavily AI 검색 API (선택 사항: 1티어 공신력 언론사 도메인 전용 필터링)
# - tavily.com 에서 무료 가입 시 월 1,000회 무료 쿼터 제공. 비워두면 Vertex AI Search Grounding으로 자동 폴백.
TAVILY_API_KEY=

# 7. [우선순위 1위] Ego Lite (CitroLabs) 데스크톱 브라우저 자동화 (선택 사항)
# - 실제 크롬의 Capology, Transfermarkt Pro, Wyscout 로그인 세션/쿠키를 복제하여 Cloudflare 차단 없이 자동 스크랩
# - 활성화 시: EGO_LITE_ENABLED=true 설정 (미설치 시 로컬 검증 Capology DB 매트릭스로 100% 자동 폴백)
EGO_LITE_ENABLED=false
EGO_LITE_HOST=http://localhost:3000
